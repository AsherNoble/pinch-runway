{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pinch-runway",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  // The app must only be reachable through the ChatGPT proxy, which injects the
  // verified oai-* identity headers. Serving the same Worker at its raw
  // *.workers.dev origin (or per-version preview URLs) bypasses that proxy and
  // lets a caller forge those headers, so both are disabled here.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    // The one hostname the app is served from. Setting this replaces the
    // permissive fallback in lib/trusted-proxy.ts with a real allowlist, so a
    // verified oai-* operator identity is honoured on the canonical host only.
    "RUNWAY_TRUSTED_PROXY_HOSTS": "pinch-runway.asherthenoble.chatgpt.site",
    "BASIQ_API_BASE_URL": "https://au-api.basiq.io",
    "BASIQ_API_VERSION": "3.0",
    "RUNWAY_AUTOMATION_MODE": "off",
    "RUNWAY_ENABLE_LIVE_DELIVERY": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinch-runway",
      "database_id": "353ed605-39d9-43f2-95ce-ad18090e6975",
      "migrations_dir": "drizzle"
    }
  ]
}
