# Runway never exposes provider credentials to the browser or stores access tokens.
# Basiq v3 bank aggregation and hosted consent.
BASIQ_API_KEY=
BASIQ_API_BASE_URL=https://au-api.basiq.io
BASIQ_API_VERSION=3.0
BASIQ_WEBHOOK_SECRET=

# Automatic reminder delivery defaults off. Test mode sends only to the safe
# operator inbox below and marks the message as a test.
RUNWAY_AUTOMATION_MODE=off
RUNWAY_TEST_RECIPIENT=
RUNWAY_ENABLE_LIVE_DELIVERY=0

# Always-on agent demo. Workers AI is provided by the Cloudflare AI binding.
RUNWAY_ENABLE_DEMO_AGENT=1

# Twilio WhatsApp Sandbox and the exact production webhook URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
RUNWAY_OWNER_WHATSAPP=
TWILIO_WEBHOOK_PUBLIC_URL=https://pinch-runway.asherthenoble.chatgpt.site/api/whatsapp

# Used only as Pinch's sandbox return URL after a demo collection.
RUNWAY_PAYMENT_RETURN_URL=http://localhost:3000/

# Resend is used by the test-mode reminder scheduler. Keep server-only.
RESEND_API_KEY=
RESEND_FROM=Runway <onboarding@resend.dev>

# Legacy Pinch sandbox tooling remains server-side and is not the invoice source
# for the bank-aware dashboard.
# Copy this file to .env.local and fill the two credentials from the Pinch
# sandbox dashboard. Do not use NEXT_PUBLIC_ for either value.
PINCH_APPLICATION_ID=
PINCH_SECRET_KEY=
PINCH_API_VERSION=2020.1
PINCH_API_BASE_URL=https://api.getpinch.com.au/test/

# Pinch webhook HMAC-SHA256 signing secret. Set as a deployment secret so the
# /api/pinch/webhook route can verify signed events. Server-only; never exposed.
PINCH_WEBHOOK_SECRET=

# This is deliberately not a NEXT_PUBLIC_ value. The internal, off-by-default
# sandbox setup page passes it directly to Pinch CaptureJS only when enabled.
PINCH_PUBLISHABLE_KEY=

# `seed` is only for a clearly labelled demo data source. `sandbox` makes the
# server-side routes call Pinch. The app must never silently fall back from
# sandbox to seed after a Pinch failure.
RUNWAY_DATA_SOURCE=seed

# Internal-only tool for creating genuine Pinch test history. Keep disabled in
# deployed environments. The setup token is a server-only operator secret.
RUNWAY_ENABLE_SANDBOX_SETUP_UI=0
RUNWAY_SANDBOX_SETUP_TOKEN=
RUNWAY_SANDBOX_OPERATOR_EMAIL=
